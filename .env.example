# Agentry settings. Copy to .env and fill in, or run:  scripts/init-env.sh agentry.example.com
# Every variable is explained in docs/CONFIGURATION.md. Never commit .env.

# --- core (REQUIRED) ------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts stored API keys and WhatsApp credentials. BACK IT UP: if it changes or is lost, every saved
# key must be entered again. Generate: openssl rand -base64 32 | tr '+/' '-_'
ENCRYPTION_KEY=
# The public https address people open (and WhatsApp providers post to).
PUBLIC_BASE_URL=https://agentry.example.com
FRONTEND_URL=https://agentry.example.com
SESSION_COOKIE_SECURE=true
# true lets you create the first account in the browser. Set false afterwards (people join by invite).
ALLOW_REGISTRATION=true

# --- where Docker publishes the app (docker-compose.yml) -------------------
# 127.0.0.1 = only a reverse proxy on the same machine can reach it (recommended).
AGENTRY_BIND=127.0.0.1
AGENTRY_PORT=8090

# --- hidden platform default model (users only ever see "Platform default") ---
# provider: openai | anthropic | gemini | deepseek | qwen | openai_compatible
# Leave empty for no hidden default: each workspace then adds its own key in Settings › Models.
PLATFORM_LLM_PROVIDER=
PLATFORM_LLM_MODEL=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# --- WhatsApp -------------------------------------------------------------
META_GRAPH_VERSION=v24.0
WHATSAPP_HTTP_TIMEOUT=20
REPLY_DELAYS_ENABLED=true

# --- optional bundled Evolution API (docker compose --profile evolution up -d) ---
EVOLUTION_API_KEY=
EVOLUTION_DB_PASSWORD=
# EVOLUTION_VERSION=v2.3.7

# --- worker / knowledge ---------------------------------------------------
WORKER_THREADS=4
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
ALLOW_PRIVATE_URL_FETCH=false
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# --- developers only -------------------------------------------------------
# Sandbox numbers, the Simulate button and the "(mock)" placeholder model. NEVER true on a public server.
ENABLE_TEST_TOOLS=false
